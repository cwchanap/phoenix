+# Screen position for click-style commands: Control center or a Node2D's
+# projected origin; null when the node kind has no screen position.
+func _node_screen_position(node: Node) -> Variant:
+	if node is Control:
+		return node.get_global_rect().get_center()
+	if node is Node2D:
+		return node.get_viewport_transform() * node.get_global_transform() * Vector2.ZERO
+	return null
+

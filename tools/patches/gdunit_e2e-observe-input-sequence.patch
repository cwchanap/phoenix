+func _observer_start(cmd: Dictionary) -> Dictionary:
+	var while_spec = cmd.get("while", {})
+	if (
+		not while_spec is Dictionary
+		or not while_spec.get("path") is String
+		or not while_spec.get("property") is String
+	):
+		return {"error": "observe requires a while {path, property, value} spec"}
+	var samples = cmd.get("samples", [])
+	if not samples is Array:
+		return {"error": "observe requires 'samples' to be a list"}
+	for sample in samples:
+		if not _observer_sample_valid(sample):
+			return {
+				"error": "observe sample requires 'name' plus exactly one of 'exists', 'method', 'property'"
+			}
+	var release_on = cmd.get("release_on", {})
+	if not release_on is Dictionary:
+		return {"error": "observe requires 'release_on' to be a map"}
+	if not release_on.is_empty():
+		if (
+			not release_on.get("sample") is String
+			or not release_on.get("actions") is Array
+		):
+			return {"error": "observe release_on requires {sample, value, actions}"}
+		for action_name in release_on["actions"]:
+			if not action_name is String:
+				return {"error": "observe release_on actions must be strings"}
+	var arm_frames = cmd.get("arm_frames", 300)
+	var max_frames = cmd.get("max_frames", 1200)
+	if (
+		not (arm_frames is int or arm_frames is float)
+		or not (max_frames is int or max_frames is float)
+	):
+		return {"error": "observe arm_frames/max_frames must be numbers"}
+	_observer = {
+		"while_path": str(while_spec["path"]),
+		"while_property": str(while_spec["property"]),
+		"while_value": while_spec.get("value", true),
+		"samples": samples,
+		"release_on": release_on,
+		"arm_frames": max(1, int(arm_frames)),
+		"max_frames": max(1, int(max_frames)),
+		"armed": 0,
+		"frames": 0,
+		"active": false,
+		"done": false,
+		"released": false,
+		"data": [],
+	}
+	return {"ok": true}
+
+
+func _observer_sample_valid(sample) -> bool:
+	if not sample is Dictionary:
+		return false
+	if not sample.get("name") is String:
+		return false
+	var selectors := 0
+	for key in ["exists", "method", "property"]:
+		if sample.has(key):
+			if not sample[key] is String:
+				return false
+			selectors += 1
+	if selectors != 1:
+		return false
+	if sample.has("exists"):
+		return true
+	if not sample.get("path") is String:
+		return false
+	if sample.has("args") and not sample["args"] is Array:
+		return false
+	return true
+
+
+func _observer_result() -> Dictionary:
+	if _observer.is_empty():
+		return {"done": true, "active": false, "frames": 0, "armed": 0, "data": []}
+	return {
+		"done": _observer["done"],
+		"active": _observer["active"],
+		"frames": _observer["frames"],
+		"armed": _observer["armed"],
+		"released": _observer["released"],
+		"data": _observer["data"],
+	}
+
+
+func _poll_observer() -> void:
+	if _observer.is_empty() or _observer["done"]:
+		return
+	var root := get_tree().root
+	var while_node := root.get_node_or_null(_observer["while_path"])
+	var live: bool = (
+		while_node != null
+		and while_node.get_indexed(NodePath(_observer["while_property"]))
+		== _observer["while_value"]
+	)
+	if not live:
+		if _observer["active"]:
+			_observer["done"] = true
+		else:
+			_observer["armed"] += 1
+			if _observer["armed"] >= _observer["arm_frames"]:
+				_observer["done"] = true
+		return
+	_observer["active"] = true
+	_observer["frames"] += 1
+	if _observer["frames"] > _observer["max_frames"]:
+		_observer["done"] = true
+		return
+	var record := {}
+	for sample in _observer["samples"]:
+		var name: String = str(sample.get("name", ""))
+		var node = root.get_node_or_null(str(sample.get("path", "")))
+		if sample.has("exists"):
+			record[name] = root.get_node_or_null(str(sample["exists"])) != null
+		elif node == null:
+			record[name] = {"_observe_error": "node_not_found"}
+		elif sample.has("method"):
+			var method: String = str(sample["method"])
+			if node.has_method(method):
+				record[name] = E2ESerializerScript.serialize(
+					node.callv(method, sample.get("args", []))
+				)
+			else:
+				record[name] = {"_observe_error": "method_not_found"}
+		elif sample.has("property"):
+			record[name] = E2ESerializerScript.serialize(
+				node.get_indexed(NodePath(str(sample["property"])))
+			)
+	_observer["data"].append(record)
+	var on: Dictionary = _observer["release_on"]
+	if not _observer["released"] and not on.is_empty():
+		if record.get(str(on.get("sample", ""))) == on.get("value", true):
+			for action_name in on.get("actions", []):
+				var release := InputEventAction.new()
+				release.action = StringName(str(action_name))
+				release.pressed = false
+				Input.parse_input_event(release)
+			_observer["released"] = true
+

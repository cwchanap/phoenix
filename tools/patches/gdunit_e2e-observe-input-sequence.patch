+# ---------------------------------------------------------------------------
+# Frame observer (non-blocking; armed by "observe", drained by "observe_result")
+# ---------------------------------------------------------------------------
+
+func _observer_start(cmd: Dictionary) -> Dictionary:
+	var while_spec = cmd.get("while", {})
+	if not while_spec is Dictionary or not while_spec.has("path"):
+		return {"error": "observe requires a while {path, property, value} spec"}
+	_observer = {
+		"while_path": str(while_spec.get("path", "")),
+		"while_property": str(while_spec.get("property", "")),
+		"while_value": while_spec.get("value", true),
+		"samples": cmd.get("samples", []),
+		"release_on": cmd.get("release_on", {}),
+		"arm_frames": max(1, int(cmd.get("arm_frames", 300))),
+		"max_frames": max(1, int(cmd.get("max_frames", 1200))),
+		"armed": 0,
+		"frames": 0,
+		"active": false,
+		"done": false,
+		"released": false,
+		"data": [],
+	}
+	return {"ok": true}
+
+
+func _observer_result() -> Dictionary:
+	if _observer.is_empty():
+		return {"done": true, "active": false, "frames": 0, "armed": 0, "data": []}
+	return {
+		"done": _observer["done"],
+		"active": _observer["active"],
+		"frames": _observer["frames"],
+		"armed": _observer["armed"],
+		"released": _observer["released"],
+		"data": _observer["data"],
+	}
+
+
+func _poll_observer() -> void:
+	if _observer.is_empty() or _observer["done"]:
+		return
+	var root := get_tree().root
+	var while_node := root.get_node_or_null(_observer["while_path"])
+	var live: bool = (
+		while_node != null
+		and while_node.get_indexed(NodePath(_observer["while_property"]))
+		== _observer["while_value"]
+	)
+	if not live:
+		if _observer["active"]:
+			_observer["done"] = true
+		else:
+			_observer["armed"] += 1
+			if _observer["armed"] >= _observer["arm_frames"]:
+				_observer["done"] = true
+		return
+	_observer["active"] = true
+	_observer["frames"] += 1
+	if _observer["frames"] > _observer["max_frames"]:
+		_observer["done"] = true
+		return
+	var record := {}
+	for sample in _observer["samples"]:
+		var name: String = str(sample.get("name", ""))
+		var node = root.get_node_or_null(str(sample.get("path", "")))
+		if sample.has("exists"):
+			record[name] = root.get_node_or_null(str(sample["exists"])) != null
+		elif node == null:
+			record[name] = {"_observe_error": "node_not_found"}
+		elif sample.has("method"):
+			var method: String = str(sample["method"])
+			if node.has_method(method):
+				record[name] = E2ESerializerScript.serialize(
+					node.callv(method, sample.get("args", []))
+				)
+			else:
+				record[name] = {"_observe_error": "method_not_found"}
+		elif sample.has("property"):
+			record[name] = E2ESerializerScript.serialize(
+				node.get_indexed(NodePath(str(sample["property"])))
+			)
+	_observer["data"].append(record)
+	# release_on: inject the listed action releases in-process the first
+	# frame a named sample matches — held-input release is scheduled here
+	# so later RPC delivery cannot hold it past the observed condition.
+	var on: Dictionary = _observer["release_on"]
+	if not _observer["released"] and not on.is_empty():
+		if record.get(str(on.get("sample", ""))) == on.get("value", true):
+			for action_name in on.get("actions", []):
+				var release := InputEventAction.new()
+				release.action = StringName(str(action_name))
+				release.pressed = false
+				Input.parse_input_event(release)
+			_observer["released"] = true
+

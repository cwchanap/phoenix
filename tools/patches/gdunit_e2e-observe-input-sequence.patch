+# ---------------------------------------------------------------------------
+# observe / observe_result — see automation_server._poll_observer()
+# ---------------------------------------------------------------------------
+
+func _cmd_observe(cmd: Dictionary, id) -> Dictionary:
+	var result: Dictionary = _server._observer_start(cmd)
+	result["id"] = id
+	return result
+
+
+func _cmd_observe_result(cmd: Dictionary, id) -> Dictionary:
+	var result: Dictionary = _server._observer_result()
+	result["id"] = id
+	return result
+

+func _cmd_input_sequence(cmd: Dictionary, id) -> Dictionary:
+	var specs: Array = cmd.get("specs", [])
+	if specs.is_empty():
+		return {"id": id, "error": "input_sequence requires a non-empty 'specs' list"}
+	var results: Array = []
+	for spec in specs:
+		if spec is Dictionary:
+			results.append(_inject_input_spec(spec))
+		else:
+			results.append({"ok": false, "error": "spec is not a Dictionary"})
+	return {"id": id, "results": results}
+
+
+func _inject_input_spec(spec: Dictionary) -> Dictionary:
+	var kind: String = str(spec.get("type", ""))
+	match kind:
+		"key":
+			var event := InputEventKey.new()
+			if bool(spec.get("physical", false)):
+				event.physical_keycode = int(spec.get("keycode", 0))
+			else:
+				event.keycode = int(spec.get("keycode", 0))
+			event.pressed = bool(spec.get("pressed", true))
+			Input.parse_input_event(event)
+			return {"ok": true}
+		"action":
+			var event := InputEventAction.new()
+			event.action = StringName(str(spec.get("action_name", "")))
+			event.pressed = bool(spec.get("pressed", true))
+			event.strength = float(spec.get("strength", 1.0))
+			Input.parse_input_event(event)
+			return {"ok": true}
+		"mouse_button":
+			var event := InputEventMouseButton.new()
+			event.position = Vector2(float(spec.get("x", 0.0)), float(spec.get("y", 0.0)))
+			event.global_position = event.position
+			event.button_index = int(spec.get("button", 1))
+			event.pressed = bool(spec.get("pressed", true))
+			Input.parse_input_event(event)
+			return {"ok": true}
+		"click":
+			var path: String = str(spec.get("path", ""))
+			var node = _server.get_tree().root.get_node_or_null(path)
+			if node == null:
+				return {"ok": false, "error": "Node not found: " + path}
+			var screen_pos = _node_screen_position(node)
+			if screen_pos == null:
+				return {
+					"ok": false,
+					"error": "Cannot determine screen position for node: " + path,
+				}
+			var press_event := InputEventMouseButton.new()
+			press_event.position = screen_pos
+			press_event.global_position = screen_pos
+			press_event.button_index = MOUSE_BUTTON_LEFT
+			press_event.pressed = true
+			Input.parse_input_event(press_event)
+			var release_event := InputEventMouseButton.new()
+			release_event.position = screen_pos
+			release_event.global_position = screen_pos
+			release_event.button_index = MOUSE_BUTTON_LEFT
+			release_event.pressed = false
+			Input.parse_input_event(release_event)
+			return {"ok": true, "position": JsonSerializer.serialize(screen_pos)}
+		_:
+			return {"ok": false, "error": "Unknown input spec type: " + kind}
+
